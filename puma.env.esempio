# Impostazioni locali di P.U.M.A.: copia questo file come  puma.env  (stessa cartella) e togli il # dalle righe che ti servono.
# Il file puma.env non va su GitHub (è nel .gitignore) perché può contenere password.

# Sedi (sigle provinciali) in cui cercare le persone in WAUC al login: rende il primo accesso molto più veloce.
# Vuoto = tutte le 107 province.
#PUMA_WAUC_SEDI=FC

# Login: come presentarsi al server di posta. Default: nome.cognome@vigilfuoco.it.
# Se PROVA_LOGIN.bat dice che il server rifiuta le credenziali ma la password è giusta, prova con solo nome.cognome:
#PUMA_IMAP_UTENTE=nome

# Rete: di default PUMA si apre solo da questo PC. Per renderlo raggiungibile dagli altri PC della rete:
#PUMA_HOST=0.0.0.0
#PUMA_PORT=8080

# Posta per l'invio del piano di sicurezza e degli avvisi di scadenza
#PUMA_SMTP_HOST=smtp.example.it
#PUMA_SMTP_PORT=587
#PUMA_SMTP_TLS=1
#PUMA_SMTP_USER=
#PUMA_SMTP_PASS=
#PUMA_MAIL_FROM=puma@vigilfuoco.it

# Mappa: server delle tile (default OpenStreetMap) e User-Agent usato per scaricarle
#PUMA_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
#PUMA_TILE_UA=PUMA-VVF/1.0 (intranet Vigili del Fuoco)

# Solo per sviluppo: password "dev" per tutti anche in modalità reale. MAI in uso reale.
#PUMA_DEV_AUTH=1
